#pragma code_page(65001)
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Patrik Maraczek"
            VALUE "FileDescription", "Watchlist device monitor"
            VALUE "FileVersion", "@WATCHLIST_ESCAPED_FULL@"
            VALUE "InternalName", "Watchlist"
            VALUE "LegalCopyright", "Copyright (C) 2026 Patrik Maraczek"
            VALUE "OriginalFilename", "Watchlist.exe"
            VALUE "ProductName", "Watchlist"
            VALUE "ProductVersion", "@WATCHLIST_ESCAPED_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default",
            "description": "Portable debug build with tests enabled. CMake discovers Ninja and the active compiler from the environment.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "WATCHLIST_ENABLE_NATIVE_ARCH": "OFF",
                "WATCHLIST_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "with-profiling",
            "displayName": "Tracy",
            "description": "Portable debug build with Tracy profiling and tests enabled.",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/profiling",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "DebugTracy",
                "BUILD_TESTING": "ON",
                "ENABLE_PROFILING": "ON"
            }
        },
        {
            "name": "sanitizers",
            "displayName": "ASan + UBSan",
            "description": "Portable Clang/GCC debug build with AddressSanitizer and UndefinedBehaviorSanitizer.",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/sanitizers",
            "cacheVariables": {
                "ENABLE_PCH": "OFF",
                "WATCHLIST_ENABLE_SANITIZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Default",
            "configurePreset": "default"
        },
        {
            "name": "with-profiling",
            "displayName": "Tracy",
            "configurePreset": "with-profiling"
        },
        {
            "name": "unit-tests",
            "displayName": "Unit Tests",
            "configurePreset": "default",
            "targets": [
                "UnitTests"
            ]
        },
        {
            "name": "unit-tests-with-profiling",
            "displayName": "Tracy + Unit Tests",
            "configurePreset": "with-profiling",
            "targets": [
                "UnitTests"
            ]
        },
        {
            "name": "sanitizers",
            "displayName": "ASan + UBSan",
            "configurePreset": "sanitizers"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "CTest Default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "with-profiling",
            "displayName": "CTest Tracy",
            "configurePreset": "with-profiling",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitizers",
            "displayName": "CTest ASan + UBSan",
            "configurePreset": "sanitizers",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
